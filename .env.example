# Solo Enterprise for agentgateway licence key (trial or enterprise).
#
# Without it the proxy runs as open source: `toolMode` silently behaves as
# `standard`, so Act 2's token-reduction scene quietly does nothing, and the
# security token service in Act 3 is unavailable. `./demo.sh --check` fails
# loudly if the key is missing or expired.
#
# Ask your Solo contact for a trial key.
ENTERPRISE_AGENTGATEWAY_LICENSE_KEY=

# AES-256-GCM key for UI session cookies (32 bytes / 64 hex characters).
# The proxy refuses to start if this is set but EMPTY, so generate one:
#   openssl rand -hex 32
OIDC_COOKIE_SECRET=

# The bundle image runs the security token service alongside the proxy.
# It hard-fails the whole unit if the loaded config has no `entSts` section;
# every act config in this repo carries one, so leaving this true is fine.
AGW_BUNDLE_STS_ENABLED=true

# Optional. Leave blank to run entirely against the bundled mock upstreams,
# which is what makes this repo runnable with no cloud credentials.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AWS_REGION=
